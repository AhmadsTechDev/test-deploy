# Salin jadi .env lalu isi nilainya: cp .env.example .env

# ---------- DIBACA docker-compose.yml ----------
POSTGRES_USER=todo
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=todo
# Wajib diisi, dipakai semua instance backend. Generate: openssl rand -base64 64
JWT_SECRET=ganti-dengan-string-acak-panjang
# Port di host untuk membuka aplikasi. Default 80; pakai 8080 kalau port 80 sudah terpakai
# APP_PORT=80

# ---------- HANYA untuk jalan backend lokal tanpa Docker ----------
# Di Docker, DATABASE_URL dirakit otomatis dari POSTGRES_* dan INSTANCE_NAME diisi per service
# DATABASE_URL=postgres://todo:ganti-password-ini@localhost:5432/todo
# PORT=3000
# INSTANCE_NAME=backend-lokal
